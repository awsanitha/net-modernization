<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.11" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude EF6 EDMX-generated files and old config files from compilation -->
    <Compile Remove="Properties/AssemblyInfo.cs" />
    <Compile Remove="UnicornShop.Designer.cs" />
    <Compile Remove="UnicornShop.cs" />
    <Content Remove="Global.asax" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <None Remove="UnicornShop.edmx" />
    <None Remove="UnicornShop.edmx.diagram" />
    <None Remove="UnicornShop.Context.tt" />
    <None Remove="UnicornShop.tt" />
    <None Remove="packages.config" />
  </ItemGroup>
</Project>
