<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UnicornShopLegacy</RootNamespace>
    <AssemblyName>UnicornShopLegacy</AssemblyName>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <!-- Suppress CS8981: legacy entity type names (basket, user, inventory) are lowercase by DB schema convention -->
    <NoWarn>$(NoWarn);CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.0">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.NewtonsoftJson" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude legacy auto-generated EF6 T4 files and legacy EDMX designer -->
    <Compile Remove="UnicornShop.Context.cs" />
    <Compile Remove="UnicornShop.Designer.cs" />
    <Compile Remove="UnicornShop.cs" />
    <Compile Remove="basket.cs" />
    <Compile Remove="user.cs" />
    <Compile Remove="inventory.cs" />
    <Compile Remove="app_unicorn.cs" />
    <Compile Remove="app_user.cs" />
    <Compile Remove="app_unicorn_basket.cs" />
    <Compile Remove="Global.asax.cs" />
    <Compile Remove="App_Start\WebApiConfig.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Exclude legacy config/markup files from content -->
    <Content Remove="Global.asax" />
    <Content Remove="Web.config" />
    <Content Remove="Web.Debug.config" />
    <Content Remove="Web.Release.config" />
    <None Remove="UnicornShop.edmx" />
    <None Remove="UnicornShop.Context.tt" />
    <None Remove="UnicornShop.tt" />
    <None Remove="packages.config" />
  </ItemGroup>
</Project>
